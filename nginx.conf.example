# nginx server block example (adjust root and TLS)
server {
  listen 80;
  server_name sen-nails-pankow.de www.sen-nails-pankow.de;
  root /var/www/sen-nails-pankow;
  index index.html;
  error_page 404 /404.html;

  rewrite ^/index\.html$ / permanent;
  rewrite ^/(.+)\.html$ /$1 permanent;
  rewrite ^/mysite/?$ / permanent;
  rewrite ^/mysite/(.+)$ /$1 permanent;

  location / { try_files $uri $uri.html $uri/ =404; }
  location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; }
  gzip on; gzip_types text/css text/javascript application/json image/svg+xml;
}
